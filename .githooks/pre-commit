#!/bin/sh
# Проверка владения путями: коммит не должен затрагивать файлы чужого
# направления. Это и есть механизм разделения — долгоживущие ветки нужны
# только как точки синхронизации, а конфликты снимаются запретом трогать
# чужие файлы, а не разнесением веток.
#
# Владелец определяется по имени текущей ветки:
#   firmware/*, firmware-dev    -> firmware
#   android/*,  android-dev     -> android
#   web/*,     web-dev         -> web
#   verify/*,  verify-dev      -> verify
#   pc-client/*, pc-client-dev  -> web  (историческое имя ветки)
#   main, master, feature/*     -> проверка не выполняется
#
# Общие файлы (README, AGENTS, CONTRIBUTING, docs/, .githooks/) править
# можно из любой ветки: они иначе и были бы источником конфликтов.
#
# Обход: git commit --no-verify  или  SKIP_PATH_OWNER=1 git commit ...

set -u

# Git выставляет эту переменную для вызовов из merge/rebase/cherry-pick:
# там набор файлов задан индексом, а не волей автора.
if [ "${SKIP_PATH_OWNER:-0}" = "1" ]; then
	exit 0
fi

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")

case "$branch" in
	firmware | firmware/* | firmware-*) owner="firmware" ;;
	android | android/* | android-*) owner="android" ;;
	web | web/* | web-*) owner="web" ;;
	# Ветка называлась pc-client-dev, когда направление называлось «клиент ПК».
	# Имя ветки оставлено как есть, чтобы не терять её историю и ссылки.
	pc-client | pc-client/* | pc-client-*) owner="web" ;;
	verify | verify/* | verify-*) owner="verify" ;;
	*) exit 0 ;;
esac

# Кто владеет путём: firmware | android | web | verify | shared | unknown
#
# ПОРЯДОК ВАЖЕН: в case первый подошедший шаблон выигрывает, поэтому более
# узкие правила стоят выше широких. Направлению проверок принадлежит
# firmware/capture/, но firmware/** целиком принадлежит прошивке — без
# более узкого правила первым совпал бы широкий, и проверки не смогли бы
# править сниффер.
path_owner() {
	case "$1" in
	firmware/capture/* | firmware/capture) echo "verify" ;;
	firmware/tools/capture-analyze.py) echo "verify" ;;
	.github/workflows/ci-verify.yml) echo "verify" ;;
	firmware/* | SECURITY.md | .github/workflows/ci-firmware.yml) echo "firmware" ;;
	android-app/* | .github/workflows/ci-android.yml) echo "android" ;;
	pc-client/* | .github/workflows/ci-pc-client.yml) echo "web" ;;
	README.md | AGENTS.md | CONTRIBUTING.md | CODE_OF_CONDUCT.md | LICENSE | NOTICE) echo "shared" ;;
	.gitignore | .gitattributes | .editorconfig) echo "shared" ;;
	docs/* | .githooks/* | tools/*) echo "shared" ;;
	.github/workflows/ci-hygiene.yml | .github/workflows/release.yml) echo "shared" ;;
	*) echo "unknown" ;;
	esac
}

own_label() {
	case "$1" in
	firmware) echo "прошивка (firmware)" ;;
	android) echo "приложение Android (android)" ;;
	web) echo "веб-панель и клиент ПК (web)" ;;
	verify) echo "проверки и измерения (verify)" ;;
	shared) echo "общий файл" ;;
	*) echo "никем не описан" ;;
	esac
}

blocked=""
shared_touched=""

for f in $(git diff --cached --name-only); do
	f_owner=$(path_owner "$f")
	case "$f_owner" in
	"$owner") ;;
	shared) shared_touched="$shared_touched $f" ;;
	*)
		blocked="$blocked $f"
		;;
	esac
done

if [ -n "$blocked" ]; then
	echo "Отказ: ветка $branch принадлежит направлению «$(own_label "$owner")»,"
	echo "а в коммите есть файлы других направлений."
	echo ""
	echo "Чужие файлы:"
	for f in $blocked; do
		echo "  $f  ->  $(own_label "$(path_owner "$f")")"
	done
	echo ""
	echo "Как поступить:"
	echo "  1. Убрать чужие файлы из индекса:  git restore --staged <файл>"
	echo "  2. Создать отдельную ветку от main под эти файлы и смержить её."
	echo "  3. Если правка всё же нужна здесь — описание в docs/BRANCHING.md,"
	echo "     обход: git commit --no-verify"
	echo ""
	echo "Матрица владения: docs/BRANCHING.md, .github/CODEOWNERS"
	exit 1
fi

if [ -n "$shared_touched" ]; then
	echo "Замечание: вместе со своими файлами изменены общие."
	echo "Общие файлы — источник конфликтов при слиянии, проверьте правку:"
	for f in $shared_touched; do
		echo "  $f"
	done
fi

exit 0