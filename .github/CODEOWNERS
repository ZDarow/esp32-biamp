# Владение путями и локальное разделение направлений
#
# Этот файл — декларация. Реальную механику проверки включает локальный
# хук .githooks/pre-commit (активируется один раз: git config core.hooksPath
# .githooks). CODEOWNERS действует на GitHub с первого пуша.
#
# Матрица дублируется в трёх местах намеренно: хук работает офлайн,
# CODEOWNERS — на сервере, docs/BRANCHING.md объясняет причину.
# При изменении матрицы правьте все три — сверку запускает CI.
#
# ПОРЯДОК ВАЖЕН. GitHub применяет ПОСЛЕДНЕЕ совпавшее правило, поэтому:
# catch-all '*' стоит ПЕРВЫМ — иначе в конце файла он перекрыл бы все
# правила выше; узкие правила измерений стоят НИЖЕ широкого /firmware/.
# Направление проверок владеет firmware/capture/, а прошивка — всем firmware/.

# ── Всё остальное ─────────────────────────────────────────────
# Новые файлы обязаны попасть в матрицу явно, иначе хук помечает их
# как «никем не описан» и не даст закоммитить из чужой ветки.
# Catch-all первым: при последнем совпадении он не должен перекрывать
# конкретные правила ниже.
*                                 @integrator

# ── Прошивка ESP32 ─────────────────────────────────────────────
/firmware/                        @firmware
/firmware/DOCUMENTATION.md        @firmware
/firmware/ESP32_BiAmp/            @firmware
/firmware/tools/                  @firmware
/firmware/.vscode/                @firmware
/SECURITY.md                      @firmware
/.github/workflows/ci-firmware.yml @firmware

# ── Проверки и измерения ───────────────────────────────────────
# Сниффер на ESP32-S3, анализатор захватов и методика аудита цифрового
# тракта. Правила ниже /firmware/: при последнем совпадении узкое
# правило перекрывает широкое.
/firmware/capture/                 @verify
/firmware/tools/capture-analyze.py @verify
/.github/workflows/ci-verify.yml   @verify

# ── Приложение Android ────────────────────────────────────────
/android-app/                     @android
/android-app/docs/                @android
/android-app/app/src/             @android
/.github/workflows/ci-android.yml @android

# ── Веб-панель и клиент для ПК ────────────────────────────────
/pc-client/                       @web
/.github/workflows/ci-pc-client.yml @web

# ── Общие файлы ───────────────────────────────────────────────
# Их правят все направления, поэтому конфликты здесь ожидаемы и
# разрешаются вручную при слиянии. Правьте их отдельным коммитом,
# чтобы конфликт был маленьким.
/README.md                        @integrator
/AGENTS.md                        @integrator
/CONTRIBUTING.md                  @integrator
/CODE_OF_CONDUCT.md               @integrator
/LICENSE                          @integrator
/NOTICE                           @integrator
/.gitignore                       @integrator
/.gitattributes                   @integrator
/.editorconfig                    @integrator
/docs/                            @integrator
/.githooks/                       @integrator
/.github/CODEOWNERS               @integrator
/protocol/                        @integrator
/tools/                           @integrator
/.github/workflows/ci-hygiene.yml @integrator
/.github/workflows/release.yml    @integrator
