# Плата — ESP32-S3-DevKitC-1. Консоль остаётся на UART0 (порт USB-UART через
# мост на плате), чтобы нативный USB был занят только двоичным потоком:
# printf в тот же порт смешал бы текст с отсчётами.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Для S3 ESP-IDF по умолчанию выбирает вторым каналом консоли USB_SERIAL_JTAG.
# Здесь это не нужно: каждый ESP_LOGI уходит и в нативный USB, то есть текст
# логов попадает в тот же поток, что и отсчёты, а запись мимо кольцевого
# буфера драйвера ещё и конфликтует с упаковщиком.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# DevKitC-1 с модулем N8: 8 МБ флеша. Снимок 30 с — это 10 МБ, но прошивка
# вместе с двумя I²S занимает мало, запас нужен на размер образа ESP-IDF.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Захват читает DMA блоками по 64 кадра, USB пишет блоками по 4 КБ. Отладка
# не нужна, скорость нужна: -Og дал бы лишние такты в цикле интерливинга.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Тик FreeRTOS — 1 мс, а не стандартные 10 мс. Плата читает четыре канала и
# склеивает их по номерам кадров, поэтому задержки в задачах задаются в
# единицах кадров, и при 10 мс задержка в 1–2 мс округляется до нуля тиков:
# vTaskDelay(0) не уступает CPU, и задача с приоритетом 4 задавливает main.
CONFIG_FREERTOS_HZ=1000

# Сторожевой таймер: задачи захвата блокируются на i2s_channel_read и на
# usb_serial_jtag_write_bytes, и при зависшем хосте это выглядит как отсутствие
# отклика. Десяти секунд хватает с большим запасом.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# Проверка IDLE-задач отключена намеренно. На S3 с задачами, закреплёнными за
# ядрами (zone0/zone1/packer на CPU1, console на CPU0), IDLE-задачи не добираются
# до сброса счётчика — паника ложная и каждые 10 с глушит захват. Защиту вместо
# них несут сами рабочие задачи: каждая подписана на сторож явно и сбрасывает его
# в начале цикла, то есть зависание в зоне, упаковщике или консоли по-прежнему
# будет поймано.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n