# ── Python-кэши ──────────────────────────────────────────────────────────
# mypy/ruff/pytest создают кэши на сторону: они не несут информации для
# сборки, зато мусорят историю коммитов. Раньше попадали в индекс,
# пока не вырезаны вручную.
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ── Сборка и инструменты ───────────────────────────────────────────────
# Артефакты прошивки (arduino-cli) и Android/Gradle
.arduino/
.arduino-cache/
.build/
build/
*/build/
.gradle/
.kotlin/
.cxx/
*.apk
*.aab
*.bin
*.elf
*.hex
*.map
output-metadata.json

# ── Эксперименты ESP-IDF ────────────────────────────────────────────────
# Локальные спайки миграции на ESP-IDF (A2DP source/sink): это черновики,
# а не исходники проекта. Рабочая Arduino-прошивка лежит в firmware/.
idf-spike/
idf-spike-*/

# Локальные варианты прошивки (альтернативные пины, имена устройств) —
# не коммитятся, используются только для локальной сборки/прошивки.
firmware/ESP32_BiAmp_Local/
firmware/ESP32_BiAmp_Local_v2/
firmware/ESP32_BiAmp_AudioControl/
firmware/ESP32_BiAmp_AudioControl_Unified/

# Каталоги сборки локального варианта прошивки (arduino-cli --build-path).
firmware/.build_local/
firmware/.build_audiocontrol/

# Локальные скрипты мониторинга COM-порта и их логи — одноразовые.
monitor_com3.ps1
monitor_output.txt
monitor_output2.txt

# ESP32-S3 DSP-хаб — отдельный проект, не часть монорепозитория BiAmp.
s3-hub/

# Локальные инструменты измерения (одноразовые скрипты).
firmware/tools/analog-*.py
firmware/tools/loopback-test.py
firmware/tools/build_local.ps1
firmware/tools/common_local.ps1

# Каталог сборки прошивки DSP-хаба (ESP32-S3).
s3-hub/.build/

# Сниффер на ESP-IDF: sdkconfig создаётся из sdkconfig.defaults и содержит
# локальные пути, каталог build/ уже исключён выше.
firmware/capture/sdkconfig
firmware/capture/sdkconfig.old

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# ── Локальная конфигурация ─────────────────────────────────────────────
# Содержит локальные пути, не должна попадать в репозиторий
local.properties
gradle.properties.local
*.jks
*.keystore
.env
.env.*

# ── Идентификаторы и редактор ──────────────────────────────────────────
.idea/
*.iml
# Локальная конфигурация редактора не коммитится. Раскомментируйте
# строки ниже, когда появятся shared настройки (settings.json, tasks.json
# и т.п.) — тогда они будут отслеживаться намеренно.
# .vscode/*
# !.vscode/settings.json
# !.vscode/tasks.json
# !.vscode/extensions.json
# !.vscode/launch.json
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Данные и захваты ──────────────────────────────────────────────────
# Захваты Bluetooth (HCI/pcap) содержат адреса устройств и данные сессий.
# В публичный репозиторий они не попадают никогда.
*.pcap
*.pcapng
log.txt
logs/
*.log

# Захваты цифрового выхода Master: WAV по 2 МБ на сценарий, сценариев
# набираются десятки — каталог быстро перерастает сотню мегабайт. Выводы
# аудита хранятся в firmware/capture/AUDIT.md, сами файлы воспроизводятся
# командой из раздела «Как воспроизвести» того же документа.
captures/

# ── Временное ─────────────────────────────────────────────────────────
gh_out.txt
gh_err.txt
*.tmp
*.bak
*.orig
*.rej

# Ключ подписи Android — только в секретах GitHub, никогда в репозитории
*.p12
*.jks
*.keystore
keystore.properties
biamp-signing.properties

# Скриншоты чужих приложений (Prology и т.п.) — материал для сравнения,
# а не исходники проекта: в публичный репозиторий не коммитим.
Screenshot_*.png


