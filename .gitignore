.arduino/
.arduino-cache/
.build/
build/
*/build/
.gradle/
.kotlin/
.cxx/
*.apk
*.aab
*.bin
*.elf
*.hex
*.map
output-metadata.json

# ── Локальная конфигурация ─────────────────────────────────────────────
# Содержит локальные пути, не должна попадать в репозиторий
local.properties
gradle.properties.local
*.jks
*.keystore
.env
.env.*

# ── Идентификаторы и редактор ──────────────────────────────────────────
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Данные и захваты ──────────────────────────────────────────────────
# Захваты Bluetooth (HCI/pcap) содержат адреса устройств и данные сессий.
# В публичный репозиторий они не попадают никогда.
*.pcap
*.pcapng
log.txt
logs/
*.log

# ── Временное ─────────────────────────────────────────────────────────
gh_out.txt
gh_err.txt
*.tmp
*.bak
*.orig
*.rej

# Ключ подписи Android — только в секретах GitHub, никогда в репозитории
*.p12
*.jks
*.keystore
keystore.properties
biamp-signing.properties

# Скриншоты чужих приложений (Prology и т.п.) — материал для сравнения,
